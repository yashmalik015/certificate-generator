{
  "version": 2,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/assets/certificate-templates/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
