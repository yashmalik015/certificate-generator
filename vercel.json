{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "src/assets/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/verify/(.*)", "destination": "/api" },
    { "source": "/verify", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
