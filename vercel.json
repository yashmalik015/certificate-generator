{
  "version": 2,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
